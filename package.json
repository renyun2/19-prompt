{
  "name": "@im-sdk/core",
  "version": "1.0.0",
  "description": "A comprehensive TypeScript IM SDK with complete type definitions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "docker:build": "docker build -t im-sdk:latest .",
    "docker:run": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "start:server": "node server/test-server.js",
    "start:test": "node server/test-server.js"
  },
  "keywords": [
    "im",
    "sdk",
    "typescript",
    "chat",
    "messaging"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "eventemitter3": "^4.0.7",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "registry": "https://registry.npmmirror.com"
}
